# ── Data lokal ───────────────────────────────────────────────
/logs
/config
cache/

# ── Lingkungan Python ────────────────────────────────────────
.venv
venv/
**/__pycache__/
*.py[cod]

# ── Antarmuka web (webui/) ───────────────────────────────────
# node_modules dan hasil build tidak masuk repositori; bangun dengan
#   cd webui && npm install && npm run build
webui/node_modules/
webui/dist/
# Direktori sementara untuk membangun ulang antarmuka (penjaga lingkungan
# memblokir penghapusan isi dist/, jadi build diarahkan ke dist_baru dulu
# lalu ditukar). Jangan ikut dilacak.
webui/dist_baru/
# Semua direktori hasil build sementara di webui (dist_rilis, dist_uji, ...).
# Sama seperti `/dist_*` di akar: pernah terjadi direktori tukar-menukar ikut
# ter-commit dan membawa ribuan berkas hasil build ke dalam repositori.
webui/dist_*
# Berkas sementara vite (berubah setiap kali build) - jangan dilacak.
webui/vite.config.js.timestamp-*.mjs

# ── Biner yang disuntikkan saat CI ───────────────────────────
libs/ffmpeg/

# ── Hasil build / paket ──────────────────────────────────────
/build
/dist
# Folder sementara saat menukar hasil build (penjaga memblokir penimpaan).
# Pola lebar: `build`/`dist` + akhiran apa pun (siap, baru, lama, ...).
# Pernah terjadi: `dist_lama/` dan `build_lama/` ikut ter-commit dan membawa
# 1.637 berkas hasil build ke dalam repositori (64% dari seluruh berkas).
/build_*
/dist_*
/installer
*.spec
.unifypy

# ── IDE & sistem ─────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store

# ── Catatan lokal ────────────────────────────────────────────
/impl.md
reports/
.claude/settings.local.json

# Berkas pesan commit sementara (dibuat sebelum `git commit -F`, lalu dihapus).
# Jangan sampai ikut ter-commit saat memakai `git add -A`.
.git_commit_msg.txt
/tmp_verif/
.tmp_verif/

# Situs dokumentasi hasil build
/_site

# Data kerja asisten (memori harian, otomasi) - bukan bagian produk
/.workbuddy-ai/
