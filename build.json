{
  "entry": "main.py",
  "name": "sela-ai",
  "display_name": "SELA AI",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "pyinstaller": {
    "onefile": false,
    "windowed": true,
    "add_data": [
      "models:models",
      "scripts:scripts",
      "src:src",
      "libs:libs",
      "assets:assets",
      "webui/dist:webui/dist"
    ],
    "clean": true,
    "noconfirm": true
  },
  "platforms": {
    "macos": {
      "bundle_identifier": "id.ac.ucic.sela-ai",
      "minimum_system_version": "10.15",
      "category": "public.app-category.education",
      "microphone_usage_description": "SELA AI memerlukan akses mikrofon agar Anda dapat bertanya dengan suara.",
      "speech_recognition_usage_description": "SELA AI menggunakan pengenalan suara untuk memahami pertanyaan Anda.",
      "camera_usage_description": "SELA AI memerlukan akses kamera untuk fitur penglihatan (opsional).",
      "copyright": "© 2026 UCIC. Seluruh hak cipta dilindungi.",
      "dmg": {
        "volname": "SELA AI Installer",
        "window_size": [600, 450],
        "icon_size": 100,
        "format": "UDZO"
      }
    },
    "windows": {
      "inno_setup": {
        "setup_icon": "assets/icon.ico",
        "license_file": "LICENSE",
        "create_desktop_icon": true,
        "create_start_menu_icon": true,
        "allow_run_after_install": true,
        "languages": ["english"]
      },
      "pyinstaller": {
        "contents_directory": "."
      }
    },
    "linux": {
      "deb": {
        "package": "sela-ai",
        "section": "utils",
        "priority": "optional",
        "desktop_entry": true,
        "categories": ["Education", "Utility"]
      }
    }
  }
}
